# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / IDE noise
.DS_Store
.idea/

# Environment
.env
.env.local

# Generated data artifact — intentionally NOT committed. matches.json is
# built from The Odds API / api-football responses, and redistributing that
# data may be restricted by the providers' terms. Generate it locally with
# your own keys (see README). Deployments that opt in to committing it via
# the refresh-match-data workflow force-add past this ignore.
site/data/matches.json

# Frontend build artifacts — regenerated by deploy-pages.yml on every
# deploy. Keeping these out of git eliminates the recurring app.js /
# app.js.map merge conflicts that fired on every PR touching src/.
site/assets/app.js
site/assets/app.js.map
site/assets/flags/

# Local Node noise
node_modules/
